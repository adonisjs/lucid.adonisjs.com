{
  "name": "adonisjs-web-stater-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "export": "vite build && npm run download:sponsors && node --import=@poppinss/ts-exec bin/build.ts",
    "postexport": "copyfiles -u 1 public/* public/**/* dist",
    "download:sponsors": "node --import=@poppinss/ts-exec bin/download_sponsors.ts",
    "start": "node bin/test.js",
    "serve": "node --import=@poppinss/ts-exec bin/serve.ts",
    "dev": "vite build && npm run serve"
  },
  "imports": {
    "#src/*": "./src/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@adonisjs/vite": "^6.0.4",
    "@alpinejs/persist": "^3.17.5",
    "@dimerapp/content": "^5.2.1",
    "@dimerapp/docs-theme": "^6.1.3",
    "@dimerapp/edge": "^5.0.0",
    "@docsearch/css": "^5.2.0",
    "@docsearch/js": "^5.2.0",
    "@poppinss/ts-exec": "^1.5.2",
    "@radix-ui/colors": "^3.0.0",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.11",
    "alpinejs": "^3.17.5",
    "collect.js": "^4.36.1",
    "concurrently": "^10.0.7",
    "copyfiles": "^2.4.1",
    "edge-uikit": "^1.0.0-1",
    "medium-zoom": "^1.1.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "typescript": "^6.0.3",
    "undici": "^8.13.1",
    "unpoly": "^3.15.0",
    "vite": "^8.4.0"
  },
  "dependencies": {
    "@adonisjs/core": "^7.7.0",
    "@adonisjs/static": "^2.0.2",
    "edge.js": "^6.5.1"
  },
  "prettier": "@adonisjs/prettier-config"
}
